{
  "name": "tower-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tower defense simple dans le navigateur : un chemin, une tourelle, des vagues sans fin.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "simulate": "node --no-warnings scripts/simulate.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:ci": "docker compose exec app npm run ci"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
